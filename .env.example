# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Message voice
SENDER_NAME=Your Name
SENDER_STYLE=Warm, genuine, concise, personal, and natural. Avoid corporate language.

# SMTP delivery. Leave blank while using preview mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_ADDRESS=

# Safety: auto mode will refuse to send unless this is explicitly true.
AUTO_SEND_ENABLED=false

